@{
    ViewData["Title"] = "Create Banner";
}

<h2 class="mb-3">Create Banner</h2>

<form asp-area="Admin" asp-controller="Banner" asp-action="Create" method="post" enctype="multipart/form-data" class="card card-body">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input id="title" name="title" class="form-control" />
    </div>

    <div class="mb-3">
        <label for="images" class="form-label">Image Upload <span class="text-danger">*</span></label>
        <input id="images" name="images" type="file" class="form-control" accept="image/*" multiple />
        <span class="text-danger">@Html.ValidationMessage("images")</span>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-area="Admin" asp-controller="Banner" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
