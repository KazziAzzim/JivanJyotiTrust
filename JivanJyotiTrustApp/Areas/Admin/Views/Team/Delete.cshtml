@model JivanJyotiTrustApp.Models.TeamMember
@{
    ViewData["Title"] = "Delete Team Member";
}

<h2 class="mb-3">Delete Team Member</h2>

<div class="card card-body">
    <p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>
    <dl class="row mb-4">
        <dt class="col-12 col-sm-3">Name</dt>
        <dd class="col-12 col-sm-9">@Model.Name</dd>
        <dt class="col-12 col-sm-3">Designation</dt>
        <dd class="col-12 col-sm-9">@Model.Designation</dd>
    </dl>

    <form asp-area="Admin" asp-controller="Team" asp-action="Delete" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div class="d-flex flex-column flex-sm-row gap-2">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-area="Admin" asp-controller="Team" asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
