@model JivanJyotiTrustApp.Areas.Admin.ViewModels.TrainingFormViewModel
@{
    var isEdit = Model.Id.HasValue;
}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet" />
<style>
    .select2-container {
        width: 100% !important;
    }

    @@media (max-width: 768px) {
        .select2-container {
            font-size: 14px;
        }
    }
</style>
<h2>@(isEdit ? "Edit" : "Create") Training</h2>
<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="card card-body">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-12 col-md-6">
            <div class="mb-3 form-group">
                <label class="form-label">City</label><select id="CityId" name="CityId" class="form-select" required>
                @if (Model.CityId.HasValue)
                {
                    var c = Model.CityOptions.FirstOrDefault(x => x.Id == Model.CityId); if (c is not null)
                    {
                        <option value="@c.Id" selected>@c.Name</option>
                    }
                }
            </select>
        </div>
    </div>
    <div class="col-12 col-md-6"><div class="mb-3 form-group"><label class="form-label">Title</label><input class="form-control" asp-for="Title" /></div></div>
    <div class="col-12 col-md-6"><div class="mb-3 form-group"><label class="form-label">Location</label><input class="form-control" asp-for="Location" /></div></div>
    <div class="col-12 col-md-6"><div class="mb-3 form-group"><label>Student Count</label><input type="number" name="StudentCount" class="form-control" min="0" value="@Model?.StudentCount" /></div></div>
    <div class="col-12"><div class="mb-3 form-group"><label class="form-label">Description</label><textarea class="form-control" rows="4" asp-for="Description"></textarea></div></div>
    <div class="col-12"><div class="mb-3 form-group"><label class="form-label">Images</label><input id="images" class="form-control" type="file" name="Images" multiple accept="image/*" /><div id="preview" class="row g-2 mt-2"></div></div></div>
</div>
@if (isEdit && Model.ExistingGalleryItems.Any())
{
    <div class="mb-2"><strong>Existing Images</strong><div class="row g-2 mt-1">@foreach(var img in Model.ExistingGalleryItems){
        <div class="col-6 col-md-3"><img src="@img.ImageUrl" class="img-fluid rounded" /></div>
    }
</div></div>
}
<div class="d-flex flex-wrap gap-2"><button class="btn btn-primary" type="submit">Save</button></div>
</form>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
<script>
    $(function () {
        var $city = $('#CityId');

        function initializeSelect2() {
            if (!$city.length) {
                console.warn('Select2 could not initialize: CityId element not found.');
                return;
            }

            try {
                $city.select2({
                    placeholder: "Select or search city",
                    width: '100%',
                    dropdownAutoWidth: true,
                    tags: true,
                    ajax: {
                        url: '/api/cities',
                        dataType: 'json',
                        delay: 250,
                        data: function (p) { return { q: p.term }; },
                        processResults: function (data) { return { results: data }; }
                    },
                    createTag: function (p) {
                        return p.term ? { id: p.term, text: "+ Add New '" + p.term + "'", newTag: true } : null;
                    }
                });

                console.log('Select2 initialized');

                $city.on('select2:select', function (e) {
                    var d = e.params.data;
                    if (d.newTag) {
                        $.ajax({
                            url: '/api/cities',
                            method: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({ name: d.id })
                        }).done(function (r) {
                            var opt = new Option(r.text, r.id, true, true);
                            $city.empty().append(opt).trigger('change');
                        });
                    }
                });
            } catch (err) {
                console.error('Error initializing Select2:', err);
            }
        }

        if ($.fn && $.fn.select2) {
            initializeSelect2();
        } else {
            // Attempt to load Select2 dynamically if it isn't available yet
            $.getScript('https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js')
                .done(function () {
                    initializeSelect2();
                })
                .fail(function () {
                    console.warn('Failed to load Select2 script from CDN.');
                });
        }
    $('#images').on('change', function () {
    const dt = new DataTransfer();
    $('#preview').empty();
    Array.from(this.files).forEach((f, index) => {
    dt.items.add(f);
    const r = new FileReader();
    r.onload = e => $('#preview').append(`<div class='col-6 col-md-3 preview-item' data-index='${index}'><div class='position-relative'><img src='${e.target.result}' class='img-fluid rounded' /><button type='button' class='btn btn-sm btn-danger position-absolute top-0 end-0 remove-preview-image' style='line-height:1;padding:0.1rem 0.35rem;'>X</button></div></div>`);
    r.readAsDataURL(f);
    });
    this.files = dt.files;
    });

    $('#preview').on('click', '.remove-preview-image', function () {
    const removeIndex = Number($(this).closest('.preview-item').data('index'));
    const fileInput = $('#images')[0];
    const dt = new DataTransfer();
    Array.from(fileInput.files).forEach((f, index) => { if (index !== removeIndex) { dt.items.add(f); } });
    fileInput.files = dt.files;
    $('#images').trigger('change');
    });
    });
</script>
