@model JivanJyotiTrustApp.Areas.Admin.ViewModels.TrainingFormViewModel
@{ var isEdit = Model.Id.HasValue; }
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<h2>@(isEdit?"Edit":"Create") Training</h2>
<form asp-action="@(isEdit?"Edit":"Create")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="card card-body">
@Html.AntiForgeryToken()
<div class="mb-3"><label class="form-label">City</label><select id="CityId" name="CityId" class="form-select" required>
@if(Model.CityId.HasValue){ var c = Model.CityOptions.FirstOrDefault(x=>x.Id==Model.CityId); if(c is not null){<option value="@c.Id" selected>@c.Name</option>}}
</select></div>
<div class="mb-3"><label class="form-label">Location</label><input class="form-control" asp-for="Location" /></div>
<div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" rows="4" asp-for="Description"></textarea></div>
<div class="mb-3"><label class="form-label">Images</label><input id="images" class="form-control" type="file" name="Images" multiple accept="image/*" /><div id="preview" class="row g-2 mt-2"></div></div>
@if(isEdit && Model.ExistingGalleryItems.Any()){<div class="mb-2"><strong>Existing Images</strong><div class="row g-2 mt-1">@foreach(var img in Model.ExistingGalleryItems){<div class="col-3"><img src="@img.ImageUrl" class="img-fluid rounded" /></div>}</div></div>}
<button class="btn btn-primary" type="submit">Save</button>
</form>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
<script>
$(function(){
$('#CityId').select2({tags:true,ajax:{url:'/api/cities',dataType:'json',delay:250,data:p=>({q:p.term}),processResults:data=>({results:data})},createTag:p=>p.term?{id:p.term,text:"+ Add New '"+p.term+"'",newTag:true}:null});
$('#CityId').on('select2:select', function(e){var d=e.params.data;if(d.newTag){$.ajax({url:'/api/cities',method:'POST',contentType:'application/json',data:JSON.stringify({name:d.id})}).done(function(r){var opt=new Option(r.text,r.id,true,true);$('#CityId').empty().append(opt).trigger('change');});}});
$('#images').on('change', function(){ $('#preview').empty(); Array.from(this.files).forEach(f=>{const r=new FileReader(); r.onload=e=>$('#preview').append(`<div class='col-3'><img src='${e.target.result}' class='img-fluid rounded' /></div>`); r.readAsDataURL(f);});});
});
</script>
