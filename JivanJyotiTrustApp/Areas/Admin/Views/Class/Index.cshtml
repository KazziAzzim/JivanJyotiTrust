@model List<JivanJyotiTrustApp.Models.ClassItem>
@{
    ViewData["Title"] = "Classes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Classes</h2>
    <a asp-area="Admin" asp-controller="Class" asp-action="Create" class="btn btn-primary">Add New Class</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped mb-0 align-middle">
                <thead>
                    <tr>
                        <th style="width:120px;">Image</th>
                        <th style="width:220px;">Name</th>
                        <th>Description</th>
                        <th style="width:220px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4">No classes found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var classItem in Model)
                        {
                            <tr>
                                <td><img src="@classItem.ImagePath" class="img-thumbnail" style="height:70px;width:100px;object-fit:cover;" alt="@classItem.Name" /></td>
                                <td>@classItem.Name</td>
                                <td>@(classItem.ShortDescription.Length > 90 ? classItem.ShortDescription[..90] + "..." : classItem.ShortDescription)</td>
                                <td>
                                    <a asp-area="Admin" asp-controller="Class" asp-action="Edit" asp-route-id="@classItem.Id" class="btn btn-sm btn-warning me-2">Edit</a>
                                    <form asp-area="Admin" asp-controller="Class" asp-action="Delete" asp-route-id="@classItem.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this class?');">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
