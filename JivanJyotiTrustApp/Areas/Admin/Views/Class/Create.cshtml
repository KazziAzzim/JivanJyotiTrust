@{
    ViewData["Title"] = "Create Class";
}

<h2 class="mb-3">Create Class</h2>

<form asp-area="Admin" asp-controller="Class" asp-action="Create" method="post" enctype="multipart/form-data" class="card card-body">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label for="name" class="form-label">Name <span class="text-danger">*</span></label>
        <input id="name" name="name" class="form-control" value="@Context.Request.Form["name"]" />
        <span class="text-danger">@Html.ValidationMessage("name")</span>
    </div>

    <div class="mb-3">
        <label for="shortDescription" class="form-label">Description <span class="text-danger">*</span></label>
        <textarea id="shortDescription" name="shortDescription" rows="4" class="form-control">@Context.Request.Form["shortDescription"]</textarea>
        <span class="text-danger">@Html.ValidationMessage("shortDescription")</span>
    </div>

    <div class="mb-3">
        <label for="image" class="form-label">Image Upload <span class="text-danger">*</span></label>
        <input id="image" name="image" type="file" class="form-control" accept="image/*" />
        <span class="text-danger">@Html.ValidationMessage("image")</span>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-area="Admin" asp-controller="Class" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
