@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
<style>
@@media (max-width: 768px) {
    .form-group { margin-bottom: 15px; }
    .btn { width: 100%; }

    #adminSidebar {
        position: fixed;
        top: 0;
        left: -250px;
        width: 250px;
        height: 100%;
        z-index: 1055;
        transition: left 0.3s ease;
        overflow-y: auto;
    }

    #adminSidebar.active {
        left: 0;
    }

    .sidebar-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.35);
        z-index: 1050;
        display: none;
    }

    .sidebar-backdrop.active {
        display: block;
    }
}
</style>
<div class="d-flex min-vh-100 flex-column flex-lg-row">
    <header class="d-lg-none bg-dark text-white p-2">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Admin Panel</h5>
            <button class="navbar-toggler d-md-none border border-light text-white" id="menuToggle" type="button" aria-controls="adminSidebar" aria-expanded="false" aria-label="Toggle navigation">☰</button>
        </div>
    </header>
    <div id="sidebarBackdrop" class="sidebar-backdrop"></div>
    <aside id="adminSidebar" class="bg-dark text-white p-3" style="width:240px;">
        <h5 class="mb-4">Admin Panel</h5>
        <nav class="nav flex-column gap-1">
            <a class="nav-link text-white @(controller == "Dashboard" ? "bg-primary rounded" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            <a class="nav-link text-white @(controller == "Class" ? "bg-primary rounded" : "")" asp-area="Admin" asp-controller="Class" asp-action="Index">Classes</a>
            <a class="nav-link text-white @(controller == "Training" ? "bg-primary rounded" : "")" asp-area="Admin" asp-controller="Training" asp-action="Index">Training</a>
            <a class="nav-link text-white @(controller == "Gallery" ? "bg-primary rounded" : "")" asp-area="Admin" asp-controller="Gallery" asp-action="Index">Gallery</a>
            <a class="nav-link text-white @(controller == "Banner" ? "bg-primary rounded" : "")" asp-area="Admin" asp-controller="Banner" asp-action="Index">Banners</a>
            <a class="nav-link text-white @(controller == "Content" ? "bg-primary rounded" : "")" asp-area="Admin" asp-controller="Content" asp-action="Index">Content</a>
            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-light w-100">Logout</button>
            </form>
        </nav>
    </aside>
    <main class="flex-grow-1">
        <header class="border-bottom p-3 bg-light">
            <h4 class="mb-0">@ViewData["Title"]</h4>
        </header>
        <div class="p-4">
            @RenderBody()
        </div>
    </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
    const menuToggle = document.getElementById('menuToggle');
    const sidebar = document.getElementById('adminSidebar');
    const backdrop = document.getElementById('sidebarBackdrop');

    if (!menuToggle || !sidebar || !backdrop) {
        return;
    }

    const closeSidebar = function () {
        sidebar.classList.remove('active');
        backdrop.classList.remove('active');
        menuToggle.setAttribute('aria-expanded', 'false');
    };

    menuToggle.addEventListener('click', function () {
        const willOpen = !sidebar.classList.contains('active');
        sidebar.classList.toggle('active');
        backdrop.classList.toggle('active');
        menuToggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
    });

    backdrop.addEventListener('click', closeSidebar);
    window.addEventListener('resize', function () {
        if (window.innerWidth >= 992) {
            closeSidebar();
        }
    });
})();
</script>
</body>
</html>
