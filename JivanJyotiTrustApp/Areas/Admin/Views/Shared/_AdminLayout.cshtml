@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
<div class="d-flex min-vh-100">
    <aside class="bg-dark text-white p-3" style="width:240px;">
        <h5 class="mb-4">Admin Panel</h5>
        <nav class="nav flex-column gap-1">
            <a class="nav-link text-white @(controller == "Dashboard" ? "bg-primary rounded" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            <a class="nav-link text-white @(controller == "Classes" ? "bg-primary rounded" : "")" asp-area="Admin" asp-controller="Classes" asp-action="Index">Classes</a>
            <a class="nav-link text-white @(controller == "Gallery" ? "bg-primary rounded" : "")" asp-area="Admin" asp-controller="Gallery" asp-action="Index">Gallery</a>
            <a class="nav-link text-white @(controller == "Banners" ? "bg-primary rounded" : "")" asp-area="Admin" asp-controller="Banners" asp-action="Index">Banners</a>
            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-light w-100">Logout</button>
            </form>
        </nav>
    </aside>
    <main class="flex-grow-1">
        <header class="border-bottom p-3 bg-light">
            <h4 class="mb-0">@ViewData["Title"]</h4>
        </header>
        <div class="p-4">
            @RenderBody()
        </div>
    </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
