@{
    ViewData["Title"] = "Achievements & Certificates";
}

<section class="achievements-certificates-section achievements-listing-section py-5">
    <div class="container">
        <div class="section-header text-center mb-4 mb-lg-5 certificate-fade-in">
            <span class="certificate-eyebrow text-uppercase">Recognition</span>
            <h2 class="fw-bold mt-2 mb-3">Achievements &amp; Certificates</h2>
            <p class="certificate-description text-muted mx-auto mb-0">Explore all achievements, certificates, and supporting documents from Jivanjyot Education and Charitable Trust.</p>
        </div>

        <div class="row g-4 justify-content-center" id="achievementsCertificatesGrid"></div>
        <div class="certificate-loader text-center mt-4 d-none" id="achievementsCertificatesLoader">
            <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
        </div>
        <p class="text-center text-muted mt-4 d-none" id="achievementsCertificatesEnd">No more achievements to show.</p>
    </div>
</section>

<div class="modal fade certificate-preview-modal" id="certificatePreviewModal" tabindex="-1" aria-labelledby="certificatePreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="certificatePreviewModalLabel">Certificate Preview</h5>
                    <p class="certificate-modal-file-name text-muted mb-0"></p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="certificate-modal-preview"></div>
            </div>
            <div class="modal-footer justify-content-center">
                <a class="btn btn-primary certificate-modal-download" href="#" download><i class="bi bi-download me-1"></i>Download</a>
            </div>
        </div>
    </div>
</div>

<style>
    .achievements-certificates-section {
        position: relative;
        overflow: hidden;
        border-radius: 1.25rem;
        background: radial-gradient(circle at top right, rgba(47, 143, 99, 0.14), transparent 30%), linear-gradient(135deg, #f8fbff 0%, #ffffff 52%, #f4faf7 100%);
    }

    .certificate-eyebrow {
        letter-spacing: 0.08em;
        font-size: 0.8rem;
        font-weight: 700;
        color: #2f8f63;
    }

    .certificate-description {
        max-width: 820px;
        line-height: 1.7;
    }

    .certificate-card {
        border-radius: 16px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .certificate-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
    }

    .certificate-link {
        border: 0;
        background: transparent;
        color: inherit;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 0;
        text-align: left;
        text-decoration: none;
        width: 100%;
    }

    .certificate-preview {
        height: 220px;
        overflow: hidden;
        background: linear-gradient(135deg, #eef7ff 0%, #f8fbff 100%);
    }

    .certificate-preview img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .certificate-card:hover .certificate-preview img {
        transform: scale(1.04);
    }

    .certificate-file-placeholder {
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        color: #0f4c81;
        border: 1px solid rgba(15, 76, 129, 0.08);
        background: linear-gradient(135deg, rgba(15, 76, 129, 0.1), rgba(47, 143, 99, 0.1));
        text-align: center;
    }

    .certificate-file-placeholder i {
        font-size: 3rem;
    }

    .certificate-file-placeholder span {
        font-weight: 800;
        letter-spacing: 0.08em;
    }

    .certificate-card-body {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        min-height: 112px;
        padding: 1rem;
    }

    .certificate-card-title {
        color: #1d2b3a;
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.35;
        margin-bottom: 0.5rem;
    }

    .certificate-file-name {
        color: #5c6f82;
        font-size: 0.9rem;
        margin-top: auto;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .certificate-fade-in {
        animation: fadeUp 0.6s ease both;
    }

    .certificate-preview-modal .modal-content {
        border: 0;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
    }

    .certificate-preview-modal .modal-body {
        background: #111827;
        min-height: 320px;
    }

    .certificate-modal-preview {
        align-items: center;
        display: flex;
        justify-content: center;
        min-height: 320px;
    }

    .certificate-modal-preview img,
    .certificate-modal-preview iframe {
        max-height: 72vh;
        max-width: 100%;
        border: 0;
        border-radius: 0.75rem;
        box-shadow: 0 18px 38px rgba(0, 0, 0, 0.28);
    }

    .certificate-modal-preview iframe {
        background: #fff;
        height: 72vh;
        width: 100%;
    }

    .certificate-modal-placeholder {
        color: #fff;
        padding: 2rem;
    }

    .certificate-modal-placeholder i {
        color: #9ec5fe;
        display: block;
        font-size: 4rem;
        margin-bottom: 1rem;
    }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@media (prefers-reduced-motion: reduce) {
        .certificate-card,
        .certificate-preview img,
        .certificate-fade-in {
            animation: none;
            transition: none;
        }
    }
</style>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
    $(function () {
        const pageSize = 8;
        let page = 1;
        let isLoading = false;
        let hasMore = true;
        const grid = $('#achievementsCertificatesGrid');
        const loader = $('#achievementsCertificatesLoader');
        const endMessage = $('#achievementsCertificatesEnd');

        function escapeHtml(value) {
            return $('<div>').text(value || '').html();
        }

        function getPlaceholder(item) {
            const label = item.fileType === 'pdf' ? 'PDF FILE' : item.fileType === 'doc' ? 'DOC FILE' : 'FILE';
            const icon = item.fileType === 'pdf' ? 'bi-file-earmark-pdf-fill' : item.fileType === 'doc' ? 'bi-file-earmark-word-fill' : 'bi-file-earmark-text-fill';
            return `<div class="certificate-file-placeholder"><i class="bi ${icon}" aria-hidden="true"></i><span>${label}</span></div>`;
        }

        function renderCard(item) {
            const safeTitle = escapeHtml(item.title || 'Achievement Certificate');
            const safeFileName = escapeHtml(item.fileName || '');
            const preview = item.fileType === 'image'
                ? `<img src="${escapeHtml(item.fileUrl)}" alt="${safeTitle}" loading="lazy" />`
                : getPlaceholder(item);

            return `<div class="col-12 col-md-6 col-lg-3 certificate-fade-in">
                <article class="certificate-card h-100">
                    <button class="certificate-link certificate-preview-trigger" type="button"
                        data-file-url="${escapeHtml(item.fileUrl)}"
                        data-download-url="${escapeHtml(item.downloadUrl)}"
                        data-file-type="${escapeHtml(item.fileType)}"
                        data-title="${safeTitle}"
                        data-file-name="${safeFileName}"
                        aria-label="Preview ${safeFileName}">
                        <div class="certificate-preview">${preview}</div>
                        <div class="certificate-card-body">
                            <h3 class="certificate-card-title">${safeTitle}</h3>
                            <p class="certificate-file-name mb-0">${safeFileName}</p>
                        </div>
                    </button>
                </article>
            </div>`;
        }

        function loadAchievements() {
            if (isLoading || !hasMore) return;
            isLoading = true;
            loader.removeClass('d-none');

            $.get('/api/achievements', { page, pageSize })
                .done(function (items) {
                    if (!items.length && page === 1) {
                        grid.html('<div class="col-12"><p class="text-center text-muted mb-0">Achievements and certificates will be available soon.</p></div>');
                    }

                    items.forEach(item => grid.append(renderCard(item)));
                    hasMore = items.length === pageSize;
                    page += 1;
                    endMessage.toggleClass('d-none', hasMore || page === 2 && !items.length);
                })
                .always(function () {
                    loader.addClass('d-none');
                    isLoading = false;
                });
        }

        function showCertificatePreview(fileUrl, downloadUrl, fileType, title, fileName) {
            const modalElement = document.getElementById('certificatePreviewModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            const preview = $('.certificate-modal-preview');
            $('.certificate-preview-modal .modal-title').text(title || 'Certificate Preview');
            $('.certificate-modal-file-name').text(fileName || '');
            $('.certificate-modal-download').attr('href', downloadUrl).attr('download', fileName || '');
            preview.empty();

            if (fileType === 'image') {
                $('<img>', { src: fileUrl, alt: title || fileName || 'Certificate preview', class: 'img-fluid' }).appendTo(preview);
            } else if (fileType === 'pdf') {
                $('<iframe>', { src: fileUrl, title: title || fileName || 'PDF preview' }).appendTo(preview);
            } else {
                preview.html(`<div class="certificate-modal-placeholder"><i class="bi bi-file-earmark-arrow-down-fill" aria-hidden="true"></i><h5>Preview is not available for this file type.</h5><p class="mb-0">Please use the Download button to view the original document.</p></div>`);
            }

            modal.show();
        }

        grid.on('click', '.certificate-preview-trigger', function () {
            const item = $(this);
            showCertificatePreview(
                item.data('file-url'),
                item.data('download-url'),
                item.data('file-type'),
                item.data('title'),
                item.data('file-name'));
        });

        $(window).on('scroll', function () {
            if ($(window).scrollTop() + $(window).height() > $(document).height() - 350) {
                loadAchievements();
            }
        });

        loadAchievements();
    });
</script>
