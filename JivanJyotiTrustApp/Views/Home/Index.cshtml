@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    var classGroups = Model.Classes.Select((item, index) => new { item, index })
        .GroupBy(x => x.index / 3)
        .Select(g => g.Select(x => x.item).ToList())
        .ToList();
}

<section class="mb-5">
    <div id="bannerCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (var i = 0; i < Model.Banners.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="@Model.Banners[i].ImagePath" class="d-block w-100" style="height:400px;object-fit:cover;" alt="@Model.Banners[i].Title" />
                </div>
            }
        </div>
    </div>
</section>

<section class="mb-5">
    <h2 class="mb-3">Classes</h2>
    <div id="classesCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (var i = 0; i < classGroups.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <div class="row">
                        @foreach (var classItem in classGroups[i])
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card h-100">
                                    <img src="@classItem.ImagePath" class="card-img-top" style="height:220px;object-fit:cover;" alt="@classItem.Name" />
                                    <div class="card-body">
                                        <h5>@classItem.Name</h5>
                                        <p class="mb-0">@classItem.ShortDescription</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#classesCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon bg-dark rounded"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#classesCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon bg-dark rounded"></span>
        </button>
    </div>
</section>

<section class="mb-4">
    <h2 class="mb-3">Gallery</h2>
    <div class="row g-3">
        @foreach (var item in Model.Gallery)
        {
            <div class="col-6 col-md-3">
                <img src="@item.ImagePath" class="img-fluid rounded shadow-sm" alt="@item.Title" style="height:180px;object-fit:cover;width:100%;" />
            </div>
        }
    </div>
</section>
