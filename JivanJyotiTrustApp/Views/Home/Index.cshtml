@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    var bannerItems = Model.Banners.Any() ? Model.Banners : [new BannerItem { Title = "Jivan Jyoti Trust", ImagePath = "/images/banners/placeholder-banner.svg" }];
}
<section id="about" class="mb-5">
    <div id="bannerCarousel" class="carousel slide banner-carousel" data-bs-ride="carousel" data-bs-pause="hover">
        <div class="carousel-inner">
            @for (var i = 0; i < bannerItems.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="@bannerItems[i].ImagePath" class="d-block w-100 banner-image" alt="@bannerItems[i].Title" />
                </div>
            }
        </div>
        <button class="carousel-control-prev slider-arrow slider-arrow-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev" aria-label="Previous banner slide">
            <span class="slider-arrow-icon" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>
        </button>
        <button class="carousel-control-next slider-arrow slider-arrow-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next" aria-label="Next banner slide">
            <span class="slider-arrow-icon" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
        </button>
    </div>
</section>


<section id="classes" class="mb-4">
    <h2 class="mb-3">Classes</h2>
    <div class="swiper classes-swiper">
        <div class="swiper-wrapper" id="classesSwiperWrapper"></div>
        <div class="swiper-pagination classes-pagination"></div>
        <div class="swiper-button-prev classes-prev slider-arrow"><i class="bi bi-chevron-left"></i></div>
        <div class="swiper-button-next classes-next slider-arrow"><i class="bi bi-chevron-right"></i></div>
    </div>
</section>


<section id="mission-vision" class="mission-vision-section py-5 mb-4">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="fw-bold">Our Mission &amp; Vision</h2>
        </div>
        <div class="row g-4">
            <div class="col-12 col-lg-6">
                <article class="mission-vision-card h-100">

                    @*                     <div class="mission-vision-icon" aria-hidden="true"><i class="bi bi-bullseye"></i></div>
                    <h3 class="h4 mb-3">Mission</h3> *@
                    <div class="d-flex align-items-center mb-3">
                        <div class="mission-vision-icon me-3 d-flex align-items-center justify-content-center" aria-hidden="true">
                            <i class="bi bi-bullseye"></i>
                        </div>
                        <h3 class="h4 mb-0 d-flex align-items-center">Mission</h3>
                    </div>

                    <p class="mb-0">To empower women and underprivileged communities by providing skill-based training, education, and entrepreneurship opportunities. The trust is committed to enhancing self-reliance through practical learning in areas such as jewelry making, handicrafts, beauty services, and other vocational skills, while also supporting basic needs, education, and the well-being of elderly individuals.</p>
                </article>
            </div>
            <div class="col-12 col-lg-6">
                <article class="mission-vision-card h-100">

                    <div class="d-flex align-items-center mb-3">
                        <div class="mission-vision-icon me-3 d-flex align-items-center justify-content-center" aria-hidden="true">
                            <i class="bi bi-lightbulb"></i>
                        </div>
                        <h3 class="h4 mb-0 d-flex align-items-center">Vision</h3>
                    </div>

                    <p class="mb-0">To create a self-sustained and inclusive society where every individual—especially women and economically weaker sections—has the skills, confidence, and opportunities to lead an independent and dignified life. The trust envisions expanding its impact across India by collaborating with government bodies, corporates, and institutions to build platforms where skilled individuals can showcase and sell their products globally.</p>
                </article>
            </div>
        </div>
    </div>
</section>

<section id="about-content" class="mb-4">
    <partial name="_DynamicContent" model='"About"' />
</section>

<section id="gallery" class="mb-4">
    <h2 class="mb-3">Training Gallery</h2>
    <div class="swiper training-swiper">
        <div class="swiper-wrapper" id="trainingGalleryInner"></div>
        <div class="swiper-pagination training-pagination"></div>
        <div class="swiper-button-prev training-prev slider-arrow"><i class="bi bi-chevron-left"></i></div>
        <div class="swiper-button-next training-next slider-arrow"><i class="bi bi-chevron-right"></i></div>
    </div>
    <div class="text-center mt-3"><a class="btn btn-outline-primary" asp-controller="Training" asp-action="Gallery">View More</a></div>
</section>

<section id="team" class="team-section py-5 mb-4">
    <div class="text-center mb-4">
        <h2 class="fw-bold mb-2">Our Team</h2>
        <p class="text-muted mb-0">Meet the people guiding our mission forward.</p>
    </div>

    <div class="row g-4 justify-content-center">
        @if (Model.TeamMembers.Any())
        {
            @foreach (var member in Model.TeamMembers)
            {
                var initial = string.IsNullOrWhiteSpace(member.Name) ? "?" : member.Name.Trim()[0].ToString().ToUpperInvariant();
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="team-card text-center h-100">
                        <div class="team-avatar" aria-hidden="true">@initial</div>
                        <h5 class="team-name">@member.Name</h5>
                        <p class="team-role mb-0">@member.Designation</p>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <p class="text-center text-muted mb-0">Team members will be available soon.</p>
            </div>
        }
    </div>
</section>

<section id="impact-stats" class="impact-stats-section mt-5">
    <div class="impact-stats-overlay rounded-4 p-4 p-lg-5">
        <div class="text-center mb-4 mb-lg-5">
            <h2 class="fw-bold mb-2">Our Impact in Numbers</h2>
            <p class="text-muted mb-0">Every training brings hope, skill, and opportunity to the community.</p>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-12 col-md-6 col-lg-4">
                <div class="impact-card text-center h-100">
                    <div class="impact-icon"><i class="bi bi-mortarboard-fill"></i></div>
                    <div class="impact-count" data-target="@Model.Stats.StudentsTrained">0</div>
                    <p class="impact-label mb-0">Students Trained</p>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="impact-card text-center h-100">
                    <div class="impact-icon"><i class="bi bi-geo-alt-fill"></i></div>
                    <div class="impact-count" data-target="@Model.Stats.TotalPlaces">0</div>
                    <p class="impact-label mb-0">Number of Places Trainings Provided</p>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="impact-card text-center h-100">
                    <div class="impact-icon"><i class="bi bi-easel2-fill"></i></div>
                    <div class="impact-count" data-target="@Model.Stats.TotalTrainings">0</div>
                    <p class="impact-label mb-0">Total Trainings Conducted</p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    body {
        overflow-x: hidden;
    }

    .banner-image {
        width: 100%;
        height: 400px;
        object-fit: cover;
    }

    .classes-swiper,
    .training-swiper {
        padding: 0.5rem 2.25rem 2.5rem;
    }

    .slider-arrow {
        width: 2.5rem;
        height: 2.5rem;
        background: rgba(15, 76, 129, 0.75);
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.3s ease, transform 0.3s ease;
    }

    .slider-arrow::after {
        content: none;
    }

    .slider-arrow:hover {
        background: rgba(15, 76, 129, 0.95);
        transform: scale(1.06);
    }

    .slider-arrow i {
        font-size: 1.1rem;
    }

    .swiper-button-prev.slider-arrow,
    .swiper-button-next.slider-arrow {
        top: 45%;
    }

    .swiper-pagination-bullet-active {
        background: #0f4c81;
    }

    .mission-vision-section {
        background: linear-gradient(135deg, #f9fcff 0%, #f3faf7 100%);
        border-radius: 1rem;
    }

    .mission-vision-card {
        background: #ffffff;
        border-radius: 1rem;
        padding: 2rem;
        box-shadow: 0 14px 28px rgba(17, 61, 99, 0.12);
        border: 1px solid rgba(15, 76, 129, 0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .mission-vision-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 34px rgba(17, 61, 99, 0.16);
        }

    .mission-vision-icon {
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        font-size: 1.35rem;
        color: #0f4c81;
        background: rgba(15, 76, 129, 0.1);
    }

    .team-section {
        background: radial-gradient(circle at top left, rgba(0, 198, 255, 0.14), transparent 32%), linear-gradient(135deg, #f9fcff 0%, #f4faf7 100%);
        border-radius: 1rem;
    }

    .team-card {
        position: relative;
        padding: 25px 15px;
        border: 1px solid rgba(255, 255, 255, 0.65);
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        opacity: 1;
        transform: none;
        animation: fadeUp 0.6s ease;
        transition: transform 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
    }

    .team-card::before {
        content: "";
        position: absolute;
        width: 120%;
        height: 120%;
        background: linear-gradient(120deg, transparent, rgba(0, 123, 255, 0.1), transparent);
        top: -100%;
        left: -100%;
        transition: top 0.5s ease, left 0.5s ease;
        pointer-events: none;
    }

    .team-card:hover {
        transform: translateY(-10px) scale(1.02);
        border-color: rgba(0, 123, 255, 0.16);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
    }

    .team-card:hover::before {
        top: 100%;
        left: 100%;
    }

    .team-avatar {
        position: relative;
        z-index: 1;
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: linear-gradient(135deg, #007bff, #00c6ff);
        color: #fff;
        font-size: 26px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        margin-bottom: 12px;
        box-shadow: 0 10px 22px rgba(0, 123, 255, 0.22);
        transition: transform 0.4s ease, box-shadow 0.4s ease;
    }

    .team-card:hover .team-avatar {
        transform: rotate(10deg) scale(1.1);
        box-shadow: 0 14px 28px rgba(0, 123, 255, 0.3);
    }

    .team-name {
        position: relative;
        z-index: 1;
        color: #1d2b3a;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .team-role {
        position: relative;
        z-index: 1;
        font-size: 14px;
        color: #666;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .team-card,
        .team-card::before,
        .team-avatar {
            animation: none;
            transition: none;
        }
    }

    .impact-stats-section {
        background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(15, 76, 129, 0.06) 100%);
    }

    .impact-stats-overlay {
        background: linear-gradient(135deg, #ffffff 0%, #f6fbff 55%, #eef7f4 100%);
        box-shadow: 0 20px 40px rgba(15, 76, 129, 0.12);
    }

    .impact-card {
        background: #ffffff;
        border-radius: 1rem;
        padding: 2rem 1.25rem;
        box-shadow: 0 12px 24px rgba(17, 61, 99, 0.12);
        border: 1px solid rgba(15, 76, 129, 0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .impact-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 30px rgba(17, 61, 99, 0.16);
        }

    .impact-icon {
        font-size: 2rem;
        color: #0f4c81;
        margin-bottom: 0.85rem;
    }

    .impact-count {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        color: #1d2b3a;
        line-height: 1.1;
        margin-bottom: 0.5rem;
    }

    .impact-label {
        color: #5c6f82;
        font-weight: 500;
    }

    @@media (max-width: 991.98px) {
        #about,
        #classes,
        #gallery,
        #about-content,
        #mission-vision,
        #team,
        #impact-stats {
            margin-bottom: 2rem !important;
        }

        .classes-swiper,
        .training-swiper {
            padding-left: 1.75rem;
            padding-right: 1.75rem;
        }

        .mission-vision-card,
        .team-card,
        .impact-card {
            padding: 1.5rem 1rem;
        }
    }

    @@media (max-width: 768px) {
        .banner-image {
            height: 200px;
            object-fit: cover;
        }

        h2 {
            font-size: 1.5rem;
        }

        .classes-swiper,
        .training-swiper {
            padding: 0.5rem 1rem 2.25rem;
        }

        .slider-arrow {
            width: 2rem;
            height: 2rem;
        }

        .slider-arrow i {
            font-size: 0.95rem;
        }

        .mission-vision-icon {
            width: 2.5rem;
            height: 2.5rem;
            font-size: 1.1rem;
        }
    }
</style>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
    $(function () {


    $('.trust-nav .nav-link[href^="#"]').on('click', function (event) {
    const targetId = $(this).attr('href');
    if (!targetId || targetId === '#') return;
    const $target = $(targetId);
    if (!$target.length) return;

    event.preventDefault();
    $('html, body').animate({
    scrollTop: $target.offset().top - 90
    }, 500);
    });

    $.get('/api/classes/random', function (data) {
    const wrapper = $('#classesSwiperWrapper');
    if (!data.length) {
    wrapper.html("<div class='swiper-slide'><p>No classes available.</p></div>");
    return;
    }
    let html = '';
    data.forEach(x => {
    html += `<div class='swiper-slide'><div class='card border-0 shadow-sm'><img src='${x.imageUrl}' class='card-img-top' style='height:220px;object-fit:cover;' /><div class='card-body'><h5 class='card-title mb-0'>${x.title}</h5></div></div></div>`;
    });
    wrapper.html(html);
    new Swiper('.classes-swiper', {
    loop: true,
    allowTouchMove: true,
    autoplay: {
    delay: 3000,
    disableOnInteraction: false
    },
    navigation: {
    nextEl: '.classes-next',
    prevEl: '.classes-prev'
    },
    pagination: {
    el: '.classes-pagination',
    clickable: true
    },
    speed: 800,
    slidesPerView: 1,
    spaceBetween: 16,
    breakpoints: {
    576: { slidesPerView: 2, spaceBetween: 16 },
    992: { slidesPerView: 3, spaceBetween: 20 },
    1200: { slidesPerView: 4, spaceBetween: 24 }
    }
    });
    });

    $.get('/api/gallery/random', function (data) {
    const wrapper = $('#trainingGalleryInner');
    if (!data.length) {
    wrapper.html("<div class='swiper-slide'><p>No images yet.</p></div>");
    return;
    }
    let html = '';
    data.forEach(x => {
    html += `<div class='swiper-slide'><img src='${x.imageUrl}' class='img-fluid rounded shadow-sm' style='height:220px;width:100%;object-fit:cover;' /></div>`;
    });
    wrapper.html(html);
    new Swiper('.training-swiper', {
    loop: true,
    allowTouchMove: true,
    autoplay: {
    delay: 3000,
    disableOnInteraction: false
    },
    navigation: {
    nextEl: '.training-next',
    prevEl: '.training-prev'
    },
    pagination: {
    el: '.training-pagination',
    clickable: true
    },
    speed: 800,
    slidesPerView: 1,
    spaceBetween: 16,
    breakpoints: {
    576: { slidesPerView: 2, spaceBetween: 16 },
    992: { slidesPerView: 3, spaceBetween: 20 },
    1200: { slidesPerView: 4, spaceBetween: 24 }
    }
    });
    });

    const impactSection = document.querySelector('#impact-stats');
    const impactCounts = document.querySelectorAll('.impact-count');
    let hasAnimatedImpactStats = false;

    function animateImpactCounter(counterElement, duration) {
    const targetValue = Number(counterElement.dataset.target || 0);
    const startTime = performance.now();

    function updateCounter(currentTime) {
    const progress = Math.min((currentTime - startTime) / duration, 1);
    const currentValue = Math.floor(progress * targetValue);
    counterElement.textContent = currentValue.toLocaleString();

    if (progress < 1) {
    requestAnimationFrame(updateCounter);
    } else {
    counterElement.textContent = targetValue.toLocaleString();
    }
    }

    requestAnimationFrame(updateCounter);
    }

    function runImpactCounterAnimation() {
    if (hasAnimatedImpactStats) {
    return;
    }

    hasAnimatedImpactStats = true;
    impactCounts.forEach((counter) => animateImpactCounter(counter, 1800));
    }

    if (impactSection && impactCounts.length) {
    if ('IntersectionObserver' in window) {
    const impactObserver = new IntersectionObserver((entries, observer) => {
    entries.forEach((entry) => {
    if (entry.isIntersecting) {
    runImpactCounterAnimation();
    observer.disconnect();
    }
    });
    }, { threshold: 0.3 });

    impactObserver.observe(impactSection);
    } else {
    runImpactCounterAnimation();
    }
    }
    });
</script>
