@model string
@using Microsoft.EntityFrameworkCore
@inject JivanJyotiTrustApp.Data.ApplicationDbContext DbContext
@{
    var entries = await DbContext.Contents
        .Include(x => x.ContentFiles)
        .Where(x => x.SectionKey == Model)
        .OrderByDescending(x => x.CreatedAt)
        .AsNoTracking()
        .ToListAsync();
}

@if (entries.Any())
{
    <section class="mb-4">
        @foreach (var entry in entries)
        {
            <div class="mb-3">
                <h3>@entry.Title</h3>
                <p>@entry.Description</p>

                @if (entry.ContentFiles.Any())
                {
                    <div class="mt-3">
                        <h5>Download Documents</h5>
                        <p class="text-muted">For more detailed information, please download the documents provided below.</p>
                        <ul class="list-group">
                            @foreach (var file in entry.ContentFiles)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@file.FileName</span>
                                    <a class="btn btn-sm btn-outline-primary" href="/Content/Download/@file.Id">Download</a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </section>
}
