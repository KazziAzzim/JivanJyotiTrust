<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JivanJyoti Trust</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --trust-blue: #0f4c81;
            --growth-green: #2f8f63;
            --saffron: #d98a1f;
            --ink: #1d2b3a;
            --bg-soft: #f7fbff;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(180deg, #ffffff 0%, var(--bg-soft) 100%);
            color: var(--ink);
        }

        .top-strip {
            background: linear-gradient(90deg, #0f4c81 0%, #1f6ba9 55%, #2f8f63 100%);
            font-size: 0.86rem;
        }

        .top-link {
            color: #f4f9ff;
            text-decoration: none;
            transition: opacity 0.25s ease;
        }

        .top-link:hover {
            opacity: 0.8;
        }

        .social-icons a {
            color: #fff;
            width: 30px;
            height: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.16);
            transition: transform 0.25s ease, background 0.25s ease;
        }

        .social-icons a:hover {
            transform: translateY(-2px);
            background: rgba(255, 255, 255, 0.3);
        }

        .main-header {
            backdrop-filter: blur(4px);
            background: rgba(255, 255, 255, 0.96);
            box-shadow: 0 10px 28px rgba(15, 76, 129, 0.12);
            border-bottom: 1px solid rgba(47, 143, 99, 0.12);
        }

        .brand-logo {
            width: 70px;
            height: 70px;
            object-fit: contain;
            border-radius: 50%;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
            border: 2px solid rgba(217, 138, 31, 0.45);
            background: #fff;
        }

        .trust-title {
            font-family: 'Cinzel', serif;
            letter-spacing: 0.04em;
            color: var(--trust-blue);
            font-size: clamp(0.95rem, 2vw, 1.25rem);
            margin: 0;
            text-align: center;
        }

        .trust-nav .nav-link {
            color: var(--ink);
            font-weight: 500;
            transition: color 0.25s ease;
            position: relative;
        }

        .trust-nav .nav-link:hover,
        .trust-nav .nav-link:focus {
            color: var(--growth-green);
        }

        .trust-nav .nav-link::after {
            content: "";
            position: absolute;
            left: 0.5rem;
            right: 0.5rem;
            bottom: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--growth-green), var(--saffron));
            transform: scaleX(0);
            transition: transform 0.25s ease;
            transform-origin: left;
        }

        .trust-nav .nav-link:hover::after {
            transform: scaleX(1);
        }

        .cta-donate {
            background: linear-gradient(135deg, var(--saffron), #f0a942);
            color: #fff;
            border: none;
            font-weight: 600;
            border-radius: 999px;
            padding: 0.55rem 1.15rem;
            box-shadow: 0 8px 20px rgba(217, 138, 31, 0.35);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
            text-decoration: none;
            white-space: nowrap;
        }

        .cta-donate:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(217, 138, 31, 0.42);
            color: #fff;
        }

        @@media (max-width: 991.98px) {
            .trust-title {
                text-align: left;
                margin-top: 0.35rem;
            }

            .main-header .navbar-collapse {
                margin-top: 0.75rem;
                border-top: 1px solid #eaf0f6;
                padding-top: 0.75rem;
            }
        }
    </style>
</head>
<body>
    <div class="top-strip text-white py-2">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <a class="top-link" href="tel:+919876543210"><i class="bi bi-telephone-fill me-1"></i>+91 98765 43210</a>
                <a class="top-link" href="mailto:contact@jivanjyottrust.org"><i class="bi bi-envelope-fill me-1"></i>contact@jivanjyottrust.org</a>
            </div>
            <div class="social-icons d-flex gap-2" aria-label="social media links">
                <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                <a href="#" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                <a href="#" aria-label="X"><i class="bi bi-twitter-x"></i></a>
            </div>
        </div>
    </div>

    <header class="main-header sticky-top">
        <div class="container">
            <nav class="navbar navbar-expand-lg py-3">
                <div class="d-flex align-items-center gap-3 me-lg-4">
                    <img src="/images/jivanjyot-logo.png" alt="Jivanjyot Education and Charitable Trust Logo" class="brand-logo" onerror="this.src='https://via.placeholder.com/140x140.png?text=Trust+Logo'" />
                    <h1 class="trust-title">JIVANJYOT EDUCATION AND CHARITABLE TRUST</h1>
                </div>

                <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#trustNav" aria-controls="trustNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-end" id="trustNav">
                    <ul class="navbar-nav trust-nav align-items-lg-center gap-lg-2 me-lg-3">
                        <li class="nav-item"><a class="nav-link" href="#">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
                        <li class="nav-item"><a class="nav-link" href="#gallery">Gallery</a></li>
                        <li class="nav-item"><a class="nav-link" href="#classes">Classes</a></li>
                    </ul>
                    <a href="#donate" class="cta-donate mt-2 mt-lg-0">Donate</a>
                </div>
            </nav>
        </div>
    </header>

    <div class="container my-4">
        @RenderBody()
    </div>
    <footer class="bg-dark text-white text-center py-3">
        &copy; @DateTime.UtcNow.Year Jivanjyot Education and Charitable Trust. All rights reserved.
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
